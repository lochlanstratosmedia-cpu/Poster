# Copy to .env and fill in. Never commit .env.

# Required. Plays the prospect and scores the call.
ANTHROPIC_API_KEY=

# Voice provider: elevenlabs, fish, or browser (browser = free built-in voice, no key needed)
TTS_PROVIDER=elevenlabs

# ElevenLabs (when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Fish Audio (when TTS_PROVIDER=fish)
FISH_API_KEY=

# Voice ids from your provider's voice library. One per prospect, with a default.
# ElevenLabs: the voice_id shown in the voice library. Fish: the model reference_id.
TTS_VOICE_DEFAULT=
TTS_VOICE_PRIYA=
TTS_VOICE_MARK=
TTS_VOICE_HELEN=

# Simple gate so only your testers can burn your API credits. Leave blank to disable.
ACCESS_CODE=

# Key for reading collected feedback at /admin/feedback?key=...
ADMIN_KEY=

PORT=3000
